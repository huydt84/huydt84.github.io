---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/site/Header.astro";
import GiscusComments from "../components/site/GiscusComments.astro";
import { getLocaleContent } from "@/data/i18n";
import type { Locale } from "@/lib/locale";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  locale: Locale;
  siteName?: string;
}

const { title, description, pubDate, tags, slug, locale, siteName } = Astro.props;
const copy = getLocaleContent(locale);
const canonical = locale === "en" ? `/blog/${slug}` : `/${locale}/blog/${slug}`;
---

<BaseLayout
  title={`${title} — ${siteName ?? "huydt84"}`}
  description={description}
  canonical={canonical}
  locale={locale}
  siteName={siteName}
>
  <Header locale={locale} variant="content" />

  <article class="mx-auto max-w-3xl px-4 pt-16">
    <a href={locale === "en" ? "/blog" : `/${locale}/blog`} class="mb-8 inline-flex text-sm text-muted-foreground transition-colors hover:text-foreground">
      &larr; {copy.ui.backToBlog}
    </a>

    <header class="mb-10">
      <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString(locale === "en" ? "en-US" : locale === "vi" ? "vi-VN" : "ja-JP", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose prose-sm max-w-none dark:prose-invert sm:prose-base">
      <slot />
    </div>
  </article>

  <GiscusComments locale={locale} />
</BaseLayout>
