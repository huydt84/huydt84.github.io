---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/site/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — huydt84"
  description="Blog posts about AI, software engineering, and technology."
  canonical="/blog"
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Blog</h1>
    <p class="text-muted-foreground mb-10">
      Thoughts on AI, software engineering, and technology.
    </p>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">No blog posts yet.</p>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
