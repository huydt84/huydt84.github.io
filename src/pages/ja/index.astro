---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/site/Header.astro";
import Hero from "../../components/site/Hero.astro";
import WorkCard from "../../components/site/WorkCard.astro";
import ExperienceTimeline from "../../components/site/ExperienceTimeline.astro";
import SkillCloud from "../../components/site/SkillCloud.astro";
import BlogCard from "../../components/site/BlogCard.astro";
import SectionHeading from "../../components/site/SectionHeading.astro";
import Footer from "../../components/site/Footer.astro";
import { getLocaleContent } from "../../data/i18n";
import { getBlogSlug, getLocalizedBlogPosts } from "../../lib/blog";

const locale = "ja";
const copy = getLocaleContent(locale);
const recentPosts = (await getLocalizedBlogPosts(locale)).slice(0, 3);
---

<BaseLayout
  title={copy.meta.siteTitle}
  description={copy.meta.siteDescription}
  locale={locale}
  siteName={copy.meta.siteTitle}
>
  <Header locale={locale} variant="home" />
  <Hero locale={locale} />

  <main class="mx-auto max-w-4xl px-4">
    <section class="mb-20">
      <SectionHeading id="work" title={copy.ui.selectedTechnicalWork} />
      <div class="grid gap-5 sm:grid-cols-2">
        {copy.selectedWork.map((work) => (
          <WorkCard work={work} />
        ))}
      </div>
    </section>

    <section class="mb-20">
      <SectionHeading id="experience" title={copy.ui.experience} />
      <ExperienceTimeline experiences={copy.experiences} />
    </section>

    <section class="mb-20">
      <SectionHeading id="writing" title={copy.ui.technicalWriting} />
      {recentPosts.length === 0 ? (
        <div class="rounded-lg border border-dashed p-8 text-center">
          <p class="text-muted-foreground">{copy.ui.blogComingSoon}</p>
        </div>
      ) : (
        <>
          <div class="grid gap-5 sm:grid-cols-2">
            {recentPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate.toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
                tags={post.data.tags}
                href={`/ja/blog/${getBlogSlug(post)}`}
              />
            ))}
          </div>
          <div class="mt-8 text-center">
            <a href="/ja/blog" class="inline-flex text-sm text-muted-foreground transition-colors hover:text-foreground">
              {copy.ui.viewAllPosts} &rarr;
            </a>
          </div>
        </>
      )}
    </section>

    <section class="mb-20">
      <SectionHeading id="skills" title={copy.ui.skills} />
      <SkillCloud skills={copy.skills} />
    </section>

    <section class="mb-20">
      <SectionHeading id="about" title={copy.ui.aboutSection} />
      <div class="max-w-3xl space-y-4 text-muted-foreground">
        {copy.about.map((p) => (
          <p class="leading-relaxed">{p}</p>
        ))}
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
