---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/site/Header.astro";
import BlogCard from "../../../components/site/BlogCard.astro";
import Footer from "../../../components/site/Footer.astro";
import { getLocaleContent } from "../../../data/i18n";
import { getBlogSlug, getLocalizedBlogPosts } from "../../../lib/blog";

const locale = "ja";
const copy = getLocaleContent(locale);
const posts = await getLocalizedBlogPosts(locale);
---

<BaseLayout
  title={`${copy.ui.blogIndexTitle} - huydt84`}
  description={copy.ui.blogIndexDescription}
  canonical="/ja/blog"
  locale={locale}
  siteName={copy.meta.siteTitle}
>
  <Header locale={locale} variant="content" />
  <div class="mx-auto max-w-4xl px-4 py-16">
    <a href="/ja" class="mb-8 inline-flex text-sm text-muted-foreground transition-colors hover:text-foreground">
      &larr; {copy.ui.home}
    </a>
    <h1 class="mb-2 mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{copy.ui.blogIndexTitle}</h1>
    <p class="mb-10 text-muted-foreground">{copy.ui.blogLead}</p>

    {posts.length === 0 ? (
      <p class="text-muted-foreground">{copy.ui.noPosts}</p>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate.toLocaleDateString("ja-JP", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
            tags={post.data.tags}
            href={`/ja/blog/${getBlogSlug(post)}`}
          />
        ))}
      </div>
    )}
  </div>
  <Footer locale={locale} />
</BaseLayout>
