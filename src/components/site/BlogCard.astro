---
import type { HTMLAttributes } from "astro/types";
import { Badge } from "@/components/ui/badge";

export interface Props extends HTMLAttributes<"a"> {
  title: string;
  description: string;
  pubDate: string;
  tags?: string[];
  href: string;
}

const { title, description, pubDate, tags, href } = Astro.props;
---

<a
  href={href}
  class="group block rounded-lg border bg-card p-5 hover:shadow-md transition-shadow"
>
  <div class="flex items-center gap-2 mb-2">
    <span class="text-xs text-muted-foreground">{pubDate}</span>
  </div>
  <h3 class="mb-2 text-lg font-semibold group-hover:text-primary transition-colors">{title}</h3>
  <p class="mb-3 text-sm text-muted-foreground leading-relaxed">{description}</p>
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <Badge variant="secondary">{tag}</Badge>
      ))}
    </div>
  )}
</a>
